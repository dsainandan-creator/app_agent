# Copy to .env and fill in. Never commit .env.

# --- Core -------------------------------------------------------------------
GEMINI_API_KEY=
SLACK_WEBHOOK_URL=
# Dry run is ON unless this is exactly false: pages are logged (stderr and
# logs/slack_dry_run.jsonl) and never posted. Set false only to really page.
SLACK_DRY_RUN=true
# Only needed if you switch embed_docs.py back to OpenAI embeddings.
OPENAI_API_KEY=

# --- Dynatrace --------------------------------------------------------------
# Platform token (dt0s16.*) with logs.read — used for DQL queries.
DYNATRACE_API_KEY=
# Classic token (dt0c01.*) with logs.ingest. Optional: falls back to DYNATRACE_API_KEY.
DYNATRACE_INGEST_KEY=
DYNATRACE_ENV_URL=https://<env-id>.apps.dynatrace.com
# The dt_ingest_log MCP tool only logs its payload unless this is false.
# (The mock app's automatic per-request forwarding to Dynatrace is not affected.)
DT_INGEST_TOOL_DRY_RUN=true

# --- Laya severity triage ---------------------------------------------------
# Off unless set to true. With false, the agent behaves exactly as before Laya.
LAYA_ENABLED=true
# shadow | advisory | enforce   (enforce falls back to advisory without a calibration file)
LAYA_MODE=shadow
# english | multilingual | typed-decisions
LAYA_MODEL=typed-decisions
# Empty = load Laya in-process. Set to a laya-serve URL to use HTTP instead, e.g.
# http://localhost:8100 (see docs/laya-serve.md).
LAYA_BASE_URL=
# Bearer token, only if laya-serve was started with LAYA_API_KEY.
LAYA_API_KEY=
LAYA_TIMEOUT_S=5
# Paging policy thresholds on Laya's calibrated P(sev1).
LAYA_PAGE_HIGH=0.80
LAYA_PAGE_LOW=0.40
LAYA_CALIBRATION_FILE=laya_triage/calibration.json
# Hard floor: a critical service at or above this Postgres 5xx % always pages.
HARD_FLOOR_ERR_PCT=50
# Comma-separated list of critical services.
CRITICAL_SERVICES=payment-service
